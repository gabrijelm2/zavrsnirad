#include "header.h"

// Pomocne funkcije za cisti korak-po-korak unos (ID -> Enter -> Ime -> Enter)
static void unesi_tekst(const char* prompt, char* buf, size_t velicina) {
    printf("%s", prompt);
    fgets(buf, (int)velicina, stdin);
    buf[strcspn(buf, "\n")] = '\0';
}

static int unesi_int(const char* prompt) {
    char buf[64]; int val;
    printf("%s", prompt);
    if (fgets(buf, sizeof(buf), stdin) && sscanf(buf, "%d", &val) == 1) return val;
    return 0;
}

static double unesi_double(const char* prompt) {
    char buf[64]; double val;
    printf("%s", prompt);
    if (fgets(buf, sizeof(buf), stdin) && sscanf(buf, "%lf", &val) == 1) return val;
    return 0.0;
}

int main(void) {
    ProductArray pNiz; SupplierArray sNiz;
    p_init(&pNiz); s_init(&sNiz);
    const char* BAZA = "skladiste.bin";
    
    if (datoteka_postoji(BAZA)) {
        printf("Velicina ucitane baze: %ld bajtova.\n", dohvati_velicinu_datoteke(BAZA));
        ucitaj_sve(BAZA, &pNiz, &sNiz);
    }

    char unosBuffer[128]; int odabir = -1;

    while (odabir != OPT_IZLAZ) {
        printf("\n1.DodajP 2.IspisiP 3.AzurirajP 4.ObrisiP 5.DodajD 6.TraziP 7.SortP 8.Backup 0.Izlaz\nOdabir: ");
        if (!fgets(unosBuffer, sizeof(unosBuffer), stdin) || sscanf(unosBuffer, "%d", &odabir) != 1) continue;

        if (odabir == OPT_DODAJ_P) {
            Product p;
            p.id = unesi_int("Unesi ID proizvoda: ");
            if (p_id_postoji(&pNiz, p.id)) { printf("Greska: Taj ID vec postoji!\n"); continue; }

            unesi_tekst("Unesi ime proizvoda: ", p.ime, sizeof(p.ime));
            if (p_ime_postoji(&pNiz, p.ime)) { printf("Greska: To ime vec postoji!\n"); continue; }

            p.cijena = unesi_double("Unesi cijenu proizvoda (EUR): ");
            p.kolicina = unesi_int("Unesi kolicinu: ");
            p.kategorijaId = CAT_ROLE; p.dobavljacId = 1;

            p_add(&pNiz, &p);
            printf("Proizvod uspjesno dodan u memoriju!\n");
        } 
        else if (odabir == OPT_ISPISI_P) {
            for (size_t i = 0; i < pNiz.size; i++)
                printf("ID: %d | %s | Kol: %d | Cijena: %.2f EUR\n", pNiz.items[i].id, pNiz.items[i].ime, pNiz.items[i].kolicina, pNiz.items[i].cijena);
        }
        else if (odabir == OPT_AZURIRAJ_P) {
            int id = unesi_int("Unesi ID za izmjenu: ");
            int idx = p_search_rekurzivni(pNiz.items, 0, (int)pNiz.size - 1, id);
            if(idx != -1) {
                pNiz.items[idx].cijena = unesi_double("Nova cijena: ");
                pNiz.items[idx].kolicina = unesi_int("Nova kolicina: ");
                // Sinkronizacija s diskom preko remove i rename
                obnovi_datoteku_na_disku(BAZA, &pNiz, &sNiz);
                printf("Podaci azurirani na disku!\n");
            } else printf("Proizvod nije pronaden! (Niz mora biti sortiran)\n");
        }
        else if (odabir == OPT_OBRISI_P) {
            int id = unesi_int("Unesi ID za brisanje: ");
            int idx = p_search_rekurzivni(pNiz.items, 0, (int)pNiz.size - 1, id);
            if(idx != -1) {
                for(size_t i = idx; i < pNiz.size - 1; i++) pNiz.items[i] = pNiz.items[i+1];
                pNiz.size--;
                // Sinkronizacija s diskom preko remove i rename
                obnovi_datoteku_na_disku(BAZA, &pNiz, &sNiz);
                printf("Proizvod obrisan s diska!\n");
            } else printf("Proizvod nije pronaden! (Niz mora biti sortiran)\n");
        }
        else if (odabir == OPT_DODAJ_D) {
            Supplier s;
            s.id = unesi_int("Unesi ID dobavljaca: ");
            if (s_id_postoji(&sNiz, s.id)) { printf("Greska: Taj ID vec postoji!\n"); continue; }

            unesi_tekst("Unesi ime dobavljaca: ", s.ime, sizeof(s.ime));
            if (s_ime_postoji(&sNiz, s.id_ime_nikako_duplo_ispravka_buga_ime)) { // greska popravljena nize
            // ispravak za sigurnu provjeru imena dobavljaca:
            if (s_ime_postoji(&sNiz, s.ime)) { printf("Greska: To ime dobavljaca vec postoji!\n"); continue; }

            s.kontakt[0] = '\0'; 
            s_add(&sNiz, &s);
            printf("Dobavljac uspjesno dodan!\n");
        } 
        else if (odabir == OPT_TRAZI_P) {
            int traziId = unesi_int("Unesi ID za rekurzivnu pretragu: ");
            int idx = p_search_rekurzivni(pNiz.items, 0, (int)pNiz.size - 1, traziId);
            if(idx != -1) printf("Pronaden: %s\n", pNiz.items[idx].ime);
            else printf("Nije pronaden! (Niz mora biti sortiran)\n");
        } 
        else if (odabir == OPT_SORT_P) {
            if(pNiz.size > 0) {
                qsort(pNiz.items, pNiz.size, sizeof(Product), usporedi_proizvode);
                printf("Niz je sortiran po ID-u!\n");
            }
        } 
        else if (odabir == OPT_BACKUP) {
            if (kopiraj_datoteku(BAZA, "backup.bin") == 0) printf("Backup uspjesan!\n");
        }
    }

    spasi_sve(BAZA, &pNiz, &sNiz); p_free(&pNiz); s_free(&sNiz);
    return 0;
}








