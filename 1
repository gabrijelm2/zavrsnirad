    CAT_STAPOVI = 0,
    CAT_ROLE,
    CAT_NAJLON,
    CAT_COUNT
} ProductCategory;

typedef enum {
    OPT_IZLAZ = 0,
    OPT_DODAJ_P,
    OPT_ISPISI_P,
    OPT_AZURIRAJ_P,
    OPT_OBRISI_P,
    OPT_DODAJ_D,
    OPT_TRAZI_P,
