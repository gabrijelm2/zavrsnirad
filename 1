// Dinamicko prosirenje (Tocka 17)
static int prosiri_p(ProductArray* a) {
    size_t nc = a->capacity ? a->capacity * 2 : 4;
    Product* tmp = (Product*)realloc(a->items, nc * sizeof(Product));
    if (!tmp) return -1;
    a->items = tmp; a->capacity = nc; return 0;
}

static int prosiri_s(SupplierArray* a) {
    size_t nc = a->capacity ? a->capacity * 2 : 4;
    Supplier* tmp = (Supplier*)realloc(a->items, nc * sizeof(Supplier));
    if (!tmp) return -1;
    a->items = tmp; a->capacity = nc; return 0;
}

void p_init(ProductArray* a) { if(a) { a->items = NULL; a->size = a->capacity = 0; } }
void s_init(SupplierArray* a) { if(a) { a->items = NULL; a->size = a->capacity = 0; } }

// Sigurno oslobadjanje resursa (Tocka 18)
void p_free(ProductArray* a) { if(a) { free(a->items); a->items = NULL; a->size = a->capacity = 0; } }
void s_free(SupplierArray* a) { if(a) { free(a->items); a->items = NULL; a->size = a->capacity = 0; } }

// CRUD - Create (Tocka 1)
int p_add(ProductArray* a, const Product* p) {
    if (!a || !p || !JE_VALJANA_KAT(p->kategorijaId)) return -1;
    if (a->size >= a->capacity && prosiri_p(a) != 0) return -1;
    a->items[a->size++] = *p; return 0;
}

int s_add(SupplierArray* a, const Supplier* s) {
    if (!a || !s) return -1;
    if (a->size >= a->capacity && prosiri_s(a) != 0) return -1;
    a->items[a->size++] = *s; return 0;
}

// Rekurzivni binarni search (Tocke 24, 25)
int p_search_rekurzivni(const Product* artikli, int niski, int visoki, int trazeniId) {
    if (niski > visoki) return -1;
    int sredina = niski + (visoki - niski) / 2;
    if (artikli[sredina].id == trazeniId) return sredina;
    return (artikli[sredina].id > trazeniId) ? 
        p_search_rekurzivni(artikli, niski, sredina - 1, trazeniId) : 
        p_search_rekurzivni(artikli, sredina + 1, visoki, trazeniId);
}

// Pokazivac na funkciju za qsort (Tocka 26)
int usporedi_proizvode(const void* a, const void* b) {
    return (((const Product*)a)->id - ((const Product*)b)->id);
}

// Datoteke i provjera velicine (Tocke 19, 20, 22)
int datoteka_postoji(const char* fn) {
    FILE* f = fopen(fn, "rb"); if (!f) return 0; fclose(f); return 1;
}

long dohvati_velicinu_datoteke(const char* fn) {
    FILE* f = fopen(fn, "rb"); if (!f) return -1;
    fseek(f, 0, SEEK_END); long sz = ftell(f); rewind(f);
    fclose(f); return sz;
}

int spasi_sve(const char* fn, const ProductArray* pa, const SupplierArray* sa) {
    if (!fn || !pa || !sa) return -1;
    FILE* f = fopen(fn, "wb"); if (!f) { perror("Greska datoteke"); return errno; }
    fwrite(&pa->size, sizeof(size_t), 1, f);
    fwrite(&sa->size, sizeof(size_t), 1, f);
    if (pa->size > 0) fwrite(pa->items, sizeof(Product), pa->size, f);
    if (sa->size > 0) fwrite(sa->items, sizeof(Supplier), sa->size, f);
    fclose(f); return 0;
}

int ucitaj_sve(const char* fn, ProductArray* pa, SupplierArray* sa) {
    if (!fn || !pa || !sa) return -1;
    FILE* f = fopen(fn, "rb"); if (!f) return -1;
    size_t p_sz = 0, s_sz = 0;
    if (fread(&p_sz, sizeof(size_t), 1, f) != 1 || fread(&s_sz, sizeof(size_t), 1, f) != 1) { fclose(f); return -1; }
    p_init(pa); s_init(sa);
    if (p_sz > 0) {
        pa->items = (Product*)malloc(p_sz * sizeof(Product));
        if (pa->items) { fread(pa->items, sizeof(Product), p_sz, f); pa->size = pa->capacity = p_sz; }
    }
    if (s_sz > 0) {
        sa->items = (Supplier*)malloc(s_sz * sizeof(Supplier));
        if (sa->items) { fread(sa->items, sizeof(Supplier), s_sz, f); sa->size = sa->capacity = s_sz; }
    }
    if (ferror(f)) { perror("Greska citanja"); } fclose(f); return 0;
}

int kopiraj_datoteku(const char* src, const char* dst) {
    if (!src || !dst) return -1;
    FILE* s = fopen(src, "rb"); FILE* d = fopen(dst, "wb");
    if (!s || !d) { if(s) fclose(s); if(d) fclose(d); return -1; }
    char meduspremnik[512]; size_t n;
    while ((n = fread(meduspremnik, 1, sizeof(meduspremnik), s)) > 0) fwrite(meduspremnik, 1, n, d);
    fclose(s); fclose(d); return 0;
}















